<?xml version="1.0" ?>
<!--
  SCARA 抓取-放置世界（Gazebo Classic 11 / SDF 1.6）
  布局与 MuJoCo 场景一致：
    台面中心 (0.40, 0)、0.52 x 0.52 m、台面高 0.10 m
    物块 30 mm 立方体，初始 (0.30, -0.05, 0.115)
    放置区 50 x 50 mm 绿色标记 (0.30, 0.12, 0.101)
  物理参数取 ODE + 1 ms 步长（与 ros2_control 1 kHz 对齐）
-->
<sdf version="1.6">
  <world name="scara_world">
    <scene>
      <ambient>0.75 0.78 0.82 1</ambient>
      <background>0.78 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.2</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 工作台：台面 + 四条腿（静态） -->
    <model name="table">
      <static>true</static>
      <link name="top">
        <pose>0.40 0 0.09 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.52 0.52 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.52 0.52 0.02</size></box></geometry>
          <material><ambient>0.78 0.66 0.48 1</ambient><diffuse>0.86 0.74 0.56 1</diffuse></material>
        </visual>
      </link>
      <link name="leg1"><pose>0.16 -0.24 0.04 0 0 0</pose>
        <collision><geometry><box><size>0.03 0.03 0.08</size></box></geometry></collision>
        <visual><geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material></visual>
      </link>
      <link name="leg2"><pose>0.64 -0.24 0.04 0 0 0</pose>
        <collision><geometry><box><size>0.03 0.03 0.08</size></box></geometry></collision>
        <visual><geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material></visual>
      </link>
      <link name="leg3"><pose>0.16 0.24 0.04 0 0 0</pose>
        <collision><geometry><box><size>0.03 0.03 0.08</size></box></geometry></collision>
        <visual><geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material></visual>
      </link>
      <link name="leg4"><pose>0.64 0.24 0.04 0 0 0</pose>
        <collision><geometry><box><size>0.03 0.03 0.08</size></box></geometry></collision>
        <visual><geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.62 0.48 0.34 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 放置区（绿色标记，静态、无碰撞） -->
    <model name="place_area">
      <static>true</static>
      <link name="link">
        <pose>0.30 0.12 0.1006 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.05 0.05 0.001</size></box></geometry>
          <material><ambient>0.15 0.75 0.25 1</ambient><diffuse>0.20 0.85 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 抓取物块：30 mm、50 g、摩擦 mu=1.2 -->
    <model name="target_box">
      <pose>0.30 -0.05 0.1150 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>7.5e-6</ixx><iyy>7.5e-6</iyy><izz>7.5e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><ambient>0.85 0.42 0.12 1</ambient><diffuse>0.95 0.50 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
